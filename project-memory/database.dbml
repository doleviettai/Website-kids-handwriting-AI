// Schema tham chiếu do người dùng cung cấp. Đã ánh xạ V1 trong backend.
// Database local thực tế: kids_handwriting; Project dưới đây giữ tên gốc.
// Không thêm status/PENDING_AI từ demo vào đây nếu chưa có quyết định thay đổi schema.
Project kids_writing_ai {
  database_type: 'MySQL'
  Note: 'Luyện viết chữ, số tiếng Việt cho trẻ - 3 model: chữ đơn, chữ ghép, đoạn văn'
}

Enum user_role {
  PARENT
  TEACHER
  ADMIN
}

Enum grade_level {
  MAU_GIAO
  LOP_1
  LOP_2
  LOP_3
  LOP_4
  LOP_5
}

Enum subject_type {
  TIENG_VIET
  TOAN
}

Enum grading_mode {
  MANUAL
  AI_ASSISTED
}

Enum invitation_status {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

Enum join_request_status {
  PENDING
  APPROVED
  REJECTED
}

Enum item_type {
  LETTER
  DIGIT
  DIGRAPH
  WORD
  SENTENCE
}

Enum submission_source {
  TOUCH
  CAMERA
}

Enum model_task {
  SINGLE_CHAR
  COMPOUND
  PARAGRAPH
}

Enum notification_type {
  NEEDS_REVIEW
  NEW_COMMENT
  TEACHER_REPORT
  CLASS_INVITATION
  JOIN_REQUEST
  HOMEWORK_ASSIGNED
  HOMEWORK_GRADED
}

Enum evaluation_rating {
  HOAN_THANH_TOT
  HOAN_THANH
  CAN_CO_GANG
}

// ============ NGƯỜI DÙNG ============
Table users {
  id bigint [pk, increment]
  email varchar(255) [unique, not null]
  password_hash varchar(255) [not null]
  full_name varchar(100)
  role user_role [not null, default: 'PARENT']
  created_at datetime [default: `now()`]
}

Table students {
  id bigint [pk, increment]
  parent_id bigint [not null, ref: > users.id]
  nickname varchar(50) [not null]
  birth_year smallint
  grade_level grade_level [not null]
  created_at datetime [default: `now()`]
}

// ============ NỘI DUNG HỌC ============
Table lessons {
  id bigint [pk, increment]
  title varchar(200) [not null]
  grade_level grade_level [not null]
  sort_order int [default: 0]
}

Table writing_items {
  id bigint [pk, increment]
  lesson_id bigint [ref: > lessons.id]
  item_type item_type [not null]
  text_value varchar(255) [not null, note: 'Chuẩn hóa NFC trước khi lưu. Câu dài nên để 255']
  difficulty tinyint [default: 1]
  template_json json [note: 'Mẫu chuẩn: {width, height, strokes: [[{x,y},...], ...]}. Với đoạn văn có thể để NULL']
  sort_order int [default: 0]

  Note: 'LETTER, DIGIT dùng model SINGLE_CHAR; DIGRAPH dùng COMPOUND; WORD, SENTENCE dùng PARAGRAPH'

  indexes {
    (item_type, text_value) [unique]
  }
}

// ============ MODEL AI ============
Table ai_models {
  id int [pk, increment]
  task model_task [not null]
  name varchar(100) [not null]
  version varchar(30) [not null, note: 'VD: v1, v2']
  model_path varchar(255) [note: 'Đường dẫn trong ai-service/models, VD: single_char/v1']
  is_active boolean [default: true, note: 'Mỗi task chỉ nên có 1 bản đang active']
  created_at datetime [default: `now()`]

  indexes {
    (task, version) [unique]
  }
}

// ============ BÀI VIẾT + KẾT QUẢ AI ============
Table submissions {
  id bigint [pk, increment]
  student_id bigint [not null, ref: > students.id]
  item_id bigint [not null, ref: > writing_items.id]
  model_id int [ref: > ai_models.id, note: 'Model đã xử lý bài này']
  source submission_source [not null]
  image_url varchar(500)
  stroke_data json [note: 'Chỉ có khi TOUCH: các nét, mỗi điểm gồm x, y, t']

  // Kết quả nhận dạng
  predicted_text varchar(500)
  confidence decimal(5,4)
  is_correct boolean [note: 'Chữ đơn/chữ ghép: predicted_text khớp item yêu cầu']
  text_accuracy decimal(5,4) [note: 'Độ chính xác ký tự (1 - tỉ lệ lỗi). Chữ đơn: 1 hoặc 0; đoạn văn: dùng để chấm']
  segments_json json [note: 'Chỉ đoạn văn: [{index, expected, predicted, confidence, score, bbox}] theo từng từ/chữ']

  // Kết quả chấm điểm (0-100)
  shape_score tinyint
  similarity_score tinyint
  direction_score tinyint [note: 'NULL nếu CAMERA']
  stroke_order_score tinyint [note: 'NULL nếu CAMERA']
  total_score tinyint
  stars tinyint
  feedback_text text

  created_at datetime [default: `now()`]

  indexes {
    (student_id, item_id, created_at)
  }
}

Table error_types {
  id int [pk, increment]
  code varchar(50) [unique, not null, note: 'VD: ROUND_TOO_OPEN, WRONG_START_POINT, STROKE_ORDER_WRONG, TOO_SMALL, WRONG_SPACING']
  name_vi varchar(150) [not null]
  feedback_template_vi text [not null]
}

Table submission_errors {
  id bigint [pk, increment]
  submission_id bigint [not null, ref: > submissions.id]
  error_type_id int [not null, ref: > error_types.id]
  segment_index tinyint [note: 'Chỉ đoạn văn: lỗi nằm ở chữ/từ thứ mấy']
  stroke_index tinyint
}

// ============ TIẾN ĐỘ ============
Table student_progress {
  student_id bigint [not null, ref: > students.id]
  item_id bigint [not null, ref: > writing_items.id]
  attempts int [default: 0]
  best_score tinyint
  last_score tinyint
  is_mastered boolean [default: false]
  last_attempt_at datetime

  indexes {
    (student_id, item_id) [pk]
  }
}


// ============ MỤC TIÊU, KẾ HOẠCH, NHẬN XÉT & THÔNG BÁO (V4) ============
Table student_goals {
  student_id bigint [pk, ref: - students.id]
  daily_target tinyint [not null, note: '1..30 bài/ngày']
  updated_at datetime [default: `now()`]
}

Table practice_plans {
  id bigint [pk, increment]
  student_id bigint [not null, ref: > students.id]
  title varchar(100) [not null]
  start_date date [not null]
  end_date date [not null]
  created_at datetime [default: `now()`]

  indexes {
    (student_id, start_date, end_date)
  }
}

Table practice_plan_items {
  plan_id bigint [not null, ref: > practice_plans.id]
  item_id bigint [not null, ref: > writing_items.id]
  repetitions tinyint [not null, note: '1..10 lượt/ngày']
  sort_order int [default: 0]

  indexes {
    (plan_id, item_id) [pk]
  }
}

Table submission_comments {
  id bigint [pk, increment]
  submission_id bigint [not null, ref: > submissions.id]
  author_id bigint [not null, ref: > users.id]
  content varchar(1000) [not null]
  created_at datetime [default: `now()`]

  indexes {
    (submission_id, created_at)
  }
}

Table notifications {
  id bigint [pk, increment]
  recipient_id bigint [not null, ref: > users.id]
  type notification_type [not null]
  submission_id bigint [ref: > submissions.id]
  student_id bigint [ref: > students.id]
  title varchar(150) [not null]
  message varchar(500) [not null]
  read_at datetime [note: 'NULL = chưa đọc']
  created_at datetime [default: `now()`]

  indexes {
    (recipient_id, read_at, created_at)
  }
}


// ============ GIÁO VIÊN CHỦ NHIỆM, LỚP HỌC, BÀI TẬP VỀ NHÀ & SỔ ĐIỂM (V5 + V6) ============
Table classrooms {
  id bigint [pk, increment]
  teacher_id bigint [not null, ref: > users.id]
  name varchar(100) [not null]
  school_year varchar(30) [not null]
  grade_level grade_level [not null]
  join_code varchar(16) [unique, not null]
  created_at datetime [default: `now()`]
}

Table classroom_enrollments {
  id bigint [pk, increment]
  classroom_id bigint [not null, ref: > classrooms.id]
  student_id bigint [ref: > students.id]
  display_name varchar(80) [not null]
  birth_year smallint
  parent_name_note varchar(100) [note: 'V6: ghi chú tên phụ huynh riêng trong lớp']
  parent_phone varchar(25) [note: 'V6: số điện thoại liên hệ phụ huynh trong lớp']
  teacher_note varchar(500) [note: 'V6: ghi chú của giáo viên về học sinh']
  joined_at datetime [default: `now()`]

  indexes {
    (classroom_id, student_id) [unique]
  }
}

Table review_batches {
  id bigint [pk, increment]
  classroom_id bigint [not null, ref: > classrooms.id]
  title varchar(150) [not null]
  subject subject_type [not null, default: 'TIENG_VIET', note: 'V6: TIENG_VIET hoặc TOAN']
  description varchar(2000) [note: 'V6: nội dung đề bài tập về nhà']
  batch_date date [not null]
  due_at datetime [note: 'V6: hạn nộp bài tập']
  required_pages tinyint [not null, default: 1, note: 'V6: số trang ảnh yêu cầu (1..10)']
  is_homework boolean [not null, default: false, note: 'V6: phân biệt bài tập về nhà và đợt chấm tại lớp']
  notes varchar(500)
  created_at datetime [default: `now()`]
}

Table student_evaluations {
  id bigint [pk, increment]
  batch_id bigint [not null, ref: > review_batches.id]
  enrollment_id bigint [not null, ref: > classroom_enrollments.id]
  score decimal(4,2) [note: 'V6: điểm số 0.00..10.00']
  rating evaluation_rating
  grading_mode grading_mode [not null, default: 'MANUAL']
  teacher_comment varchar(1000)
  needs_attention boolean [not null, default: false]
  image_url varchar(500) [note: 'Chờ tích hợp model chụp vở V5+Kids']
  ai_metrics_json json [note: 'Chờ tích hợp model chụp vở V5+Kids']
  submitted_at datetime [note: 'V6: thời điểm phụ huynh nộp ảnh bài tập']
  graded_at datetime [note: 'V6: thời điểm giáo viên chấm']
  scheduled_send_at datetime [note: 'V6: hẹn giờ tự động gửi điểm cho phụ huynh']
  sent_to_parent_at datetime
  updated_at datetime [default: `now()`]

  indexes {
    (batch_id, enrollment_id) [unique]
  }
}

Table classroom_invitations {
  id bigint [pk, increment]
  classroom_id bigint [not null, ref: > classrooms.id]
  enrollment_id bigint [ref: > classroom_enrollments.id]
  invited_email varchar(255) [not null]
  invited_user_id bigint [ref: > users.id]
  status invitation_status [not null, default: 'PENDING']
  created_at datetime [default: `now()`]
  responded_at datetime
}

Table classroom_join_requests {
  id bigint [pk, increment]
  classroom_id bigint [not null, ref: > classrooms.id]
  student_id bigint [not null, ref: > students.id]
  parent_id bigint [not null, ref: > users.id]
  message varchar(300)
  status join_request_status [not null, default: 'PENDING']
  created_at datetime [default: `now()`]
  reviewed_at datetime
}

Table homework_submission_pages {
  id bigint [pk, increment]
  evaluation_id bigint [not null, ref: > student_evaluations.id]
  page_number tinyint [not null]
  image_path varchar(500) [not null]
  original_filename varchar(255)
  uploaded_at datetime [default: `now()`]

  indexes {
    (evaluation_id, page_number) [unique]
  }
}
